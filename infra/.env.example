# Настройки продакшена. Скопировать в infra/.env на сервере и заполнить.
# Ключи и секрет сгенерировать: bash scripts/gen-secrets.sh

# Домен сервиса: сайт, API и сигналинг LiveKit живут на нём (A-запись → внешний IP)
DOMAIN=call.example.com

# Внешний IP сервера. Его LiveKit сообщает браузерам для видео и звука
NODE_IP=188.164.152.23

# Порт на 127.0.0.1, куда nginx хоста проксирует домен. Не должен совпадать с портами других проектов
WEB_PORT=8110

# Ключи LiveKit
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# Секрет подписи ID встреч. Если его сменить, все старые ссылки перестанут работать
MEETING_SECRET=REPLACE_ME

# Лимиты (необязательно)
MAX_ACTIVE_MEETINGS=10
MAX_PARTICIPANTS=10
