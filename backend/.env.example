# ----- LiveKit credentials (must match infra/.env) -----
LIVEKIT_API_KEY=REPLACE_ME_API_KEY
LIVEKIT_API_SECRET=REPLACE_ME_API_SECRET

# Public WebSocket URL that browsers and apps connect to
LIVEKIT_URL=ws://localhost:7880
# URL the backend uses for the LiveKit server API. Empty = same as LIVEKIT_URL.
LIVEKIT_API_URL=

# ----- CORS -----
# Only needed when the web app is served from another domain than the API.
CORS_ORIGINS=http://localhost:5173

# Secret for signing meeting IDs. Empty = LIVEKIT_API_SECRET.
MEETING_SECRET=

# ----- Limits -----
MAX_ACTIVE_MEETINGS=10          # meetings at the same time
MAX_PARTICIPANTS=10             # people per meeting
EMPTY_TIMEOUT_SECONDS=600       # created but nobody came
DEPARTURE_TIMEOUT_SECONDS=120   # everyone left
MAX_MEETING_HOURS=8             # hard cap on one meeting
CREATE_PER_IP_PER_HOUR=20
JOIN_PER_IP_PER_MINUTE=30
